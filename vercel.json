{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/summarize", "dest": "/api/summarize.js" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/app.html", "dest": "/public/app.html" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/(.*\\.(html|css|js|ico|png|jpg|svg))", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
